APP_NAME="Gimnacio V1"
APP_ENV=local
APP_KEY=base64:OOIW78ID7WQ26ocpNC+POHOuqf0EqN84SefHRvhleHc=
APP_DEBUG=true
APP_URL=http://gimnacio_v1.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gimnacio_v1
DB_USERNAME=root
DB_PASSWORD=

# Registro de consultas lentas (ms). Solo tiene efecto con APP_DEBUG=true. Útil en staging/local.
DB_SLOW_QUERY_LOG_MS=0

# Datos masivos para pruebas de carga (MassiveRootSeeder): SEED_MASSIVE_CLIENTES, SEED_MASSIVE_LEADS,
# SEED_MASSIVE_PRODUCTOS, SEED_MASSIVE_SERVICIOS, SEED_MASSIVE_EMPLEADOS, SEED_MASSIVE_ESPACIOS,
# SEED_MASSIVE_MEMBRESIAS, SEED_MASSIVE_CLASES (valores enteros).

CRM_AUTOMATION_USER_ID=1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Colas: para exportaciones pesadas de reportes (Excel/PDF) activar REPORTES_QUEUE_EXPORTS=true
# y ejecutar un worker (p. ej. php artisan queue:work). Ver config/reportes.php.
REPORTES_QUEUE_EXPORTS=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Checklist deploy permisos (Spatie): migrate --force → db:seed (RoleSeeder vía BaseCatalog) →
#   php artisan permission:cache-reset
# (o optimize:clear si no existe el comando en tu versión)
