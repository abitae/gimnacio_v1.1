BIOTIME_URL=http://127.0.0.1:8090
BIOTIME_USER=admin
BIOTIME_PASS=changeme
# emp_code del empleado de prueba (en produccion = cliente.id Laravel)
BIOTIME_EMP_CODE=4
# Area AUTORIZADA (ej. "autorizado") — NO uses el id de "No autorizado"
BIOTIME_AREA_ID=2
# Area denegada (ej. "No autorizado") usada al desactivar; BioTime no acepta area=[]
BIOTIME_DENIED_AREA_ID=1
# Prefer jwt | token | auto (tries jwt then token)
BIOTIME_AUTH_MODE=auto
