# Copiar a config.yaml y completar valores por sede.
# Token: BioTime UI Laravel → Sedes → regenerar/copiar (Bearer / X-BioTime-Secret).

laravel_base_url: "https://tudominio.com"   # sin slash final; rutas bajo /api/biotime/*
laravel_token: "bt_REEMPLAZAR"
# false solo en HTTPS local con cert auto-firmado. En Banahosting/produccion: true (default).
laravel_verify_ssl: true
# Override si el WAF del hosting bloquea el UA por defecto.
laravel_user_agent: "BioTimeBridge/0.1 (+gimnasio)"

biotime_base_url: "http://127.0.0.1:8085"
biotime_user: "admin"
biotime_password: "changeme"
biotime_auth_mode: "auto"   # auto | jwt | token

# Area AUTORIZADA (ej. "autorizado"). NO uses el id de "No autorizado".
area_id: 2
# Area denegada: BioTime 8 rechaza area=[]; deactivate asigna este id (ej. "No autorizado"=1).
denied_area_id: 1
# Company/department requeridos al crear empleados desde Laravel (activate ensure_create).
company_id: 1
department_id: 1

sucursal_codigo: "principal"
poll_seconds: 60

# Reconciliacion periodica con GET /api/biotime/roster (0 = desactivado)
roster_reconcile_seconds: 3600
# Push employees hacia Laravel POST /api/biotime/sync (0 = desactivado)
sync_push_seconds: 300

dry_run: false
http_timeout_seconds: 30
max_retries: 3
retry_backoff_seconds: 2

log_dir: "logs"
log_level: "INFO"
